#!/bin/sh
# Droidspaces: the bspwm session, run as the desktop user by bspwm-start.
# User-agnostic body of the interactive ~/start-desktop.sh (no scale seeding, no already-running
# guard — the systemd service owns the lifecycle).
export DISPLAY="${DISPLAY:-:5}"
# Termux:X11 uses an unauthenticated socket; a stale XAUTHORITY from the login session breaks it.
unset XAUTHORITY
export HOME="${HOME:-$(getent passwd "$(id -u)" | cut -d: -f6)}"
export USER="${USER:-$(id -un)}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export LANG="${LANG:-en_US.UTF-8}"
export XDG_CURRENT_DESKTOP=bspwm
export GTK_THEME=catppuccin-mocha-lavender-standard+default
export _JAVA_AWT_WM_NONREPARENTING=1
export TERMINAL=xfce4-terminal

if ! xdpyinfo >/dev/null 2>&1; then
    echo "No X server on $DISPLAY after handoff" >&2
    exit 1
fi
exec dbus-launch --exit-with-session bspwm
