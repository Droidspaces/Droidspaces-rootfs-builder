#!/bin/sh
# bspwm for touch: no modifier keys, every action is a toolbar tap.

. "$HOME/.config/bspwm/lib.sh"
bspc monitor -d $(seq 1 "$(cfg_get DESKTOPS 2)" | tr '
' ' ')

# UI scale (saved in ~/.config/bspwm/scale, changed from the top-bar scale button)
. "$HOME/.config/bspwm/scale-env.sh"

bspc config normal_border_color   "#313244"
bspc config active_border_color   "#45475a"
bspc config focused_border_color  "$UI_ACCENT"
bspc config presel_feedback_color "$UI_ACCENT"

bspc config border_width          "$UI_BORDER"
bspc config window_gap            "$UI_GAP"
bspc config split_ratio           0.5
bspc config borderless_monocle    true
bspc config gapless_monocle       false
bspc config single_monocle        false

bspc config automatic_scheme      alternate
bspc config initial_polarity      second_child
bspc config removal_adjustment    true

bspc config pointer_follows_focus false
bspc config swallow_first_click   false
bspc config ignore_ewmh_focus     false

# Padding is set by the bars' struts; adjusted below if bspwm ignores them.
bspc config top_padding    0
bspc config bottom_padding 0
bspc config left_padding   0
bspc config right_padding  0

bspc rule -a Rofi          state=floating
bspc rule -a gsimplecal    state=floating center=on sticky=on
bspc rule -a Gsimplecal    state=floating center=on sticky=on
bspc rule -a Pavucontrol   state=floating center=on sticky=on
bspc rule -a Polybar       manage=off
bspc rule -a Dunst         manage=off

pkill -x picom; pkill -x dunst; pkill -x polybar
"$HOME/.config/bspwm/apply.sh"
"$HOME/.config/bspwm/wallpaper-render.sh" &
dunst &
sleep 0.3; [ "$(cfg_get NOTIFY on)" = on ] || dunstctl set-paused true
pkill -f "[e]dge-resize.py"; python3 "$HOME/.config/bspwm/edge-resize.py" &
"$HOME/.config/polybar/launch.sh" &

# Termux:X11 resizes the screen when its extra-keys row is shown/hidden: refresh wallpaper pixmap and bars.
pkill -f "[b]spc subscribe monitor_geometry"; pkill -f "[s]creen-watch.sh"
"$HOME/.config/bspwm/screen-watch.sh" &
pkill -f "[d]esktops.sh watch"; "$HOME/.config/bspwm/desktops.sh" watch &

# User autostart scripts (Settings > Autostart): executable files in autostart.d run at login
for f in "$HOME/.config/bspwm/autostart.d"/*; do [ -x "$f" ] && "$f" & done

# Pre-render launcher icons (instant icons in the app list); cheap once cached
( sleep 8; python3 "$HOME/.config/bspwm/icon-cache.py" >/dev/null 2>&1 ) &
